CREATE TABLE Producto (
    id TEXT NOT NULL PRIMARY KEY,
    descripcion TEXT NOT NULL,
    fotoPath TEXT NOT NULL,
    precioTotalCentavos INTEGER NOT NULL
);

upsertProducto:
INSERT OR REPLACE INTO Producto(id, descripcion, fotoPath, precioTotalCentavos)
VALUES (?, ?, ?, ?);

selectProductoById:
SELECT * FROM Producto WHERE id = ?;
