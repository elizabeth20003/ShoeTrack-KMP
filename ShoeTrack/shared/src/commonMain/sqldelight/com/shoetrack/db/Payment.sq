CREATE TABLE Payment (
    id TEXT NOT NULL PRIMARY KEY,
    layawayId TEXT NOT NULL,
    amountCents INTEGER NOT NULL,
    paidAt INTEGER NOT NULL,
    recordedByDeviceId TEXT NOT NULL,
    FOREIGN KEY (layawayId) REFERENCES Layaway(id)
);

insertPayment:
INSERT INTO Payment(id, layawayId, amountCents, paidAt, recordedByDeviceId)
VALUES (?, ?, ?, ?, ?);

selectPaymentsByLayaway:
SELECT * FROM Payment WHERE layawayId = ? ORDER BY paidAt ASC;
