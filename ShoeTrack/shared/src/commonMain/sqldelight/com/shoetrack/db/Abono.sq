CREATE TABLE Abono (
    id TEXT NOT NULL PRIMARY KEY,
    apartadoId TEXT NOT NULL,
    montoCentavos INTEGER NOT NULL,
    fecha INTEGER NOT NULL,
    registradoPorDeviceId TEXT NOT NULL,
    FOREIGN KEY (apartadoId) REFERENCES Apartado(id)
);

insertAbono:
INSERT INTO Abono(id, apartadoId, montoCentavos, fecha, registradoPorDeviceId)
VALUES (?, ?, ?, ?, ?);

selectAbonosPorApartado:
SELECT * FROM Abono WHERE apartadoId = ? ORDER BY fecha ASC;
